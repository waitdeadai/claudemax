{
  "name": "@claudemax/grounding",
  "version": "0.2.2",
  "description": "claudemax grounding compile — promotes blessed vault notes into memory.sqlite (decisions + project_facts) and compiles invariants into CLAUDE.md managed blocks.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@claudemax/memory": "workspace:*",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/waitdeadai/claudemax",
    "directory": "packages/grounding"
  },
  "homepage": "https://github.com/waitdeadai/claudemax/tree/main/packages/grounding#readme",
  "bugs": "https://github.com/waitdeadai/claudemax/issues",
  "keywords": [
    "claudemax",
    "grounding",
    "obsidian",
    "vault",
    "sqlite",
    "claude-md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
